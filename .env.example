# 本地真机不能使用 127.0.0.1；请改成电脑在同一 Wi-Fi 下的局域网地址。
# Vercel 网页部署不设置此变量，网页将自动使用同域 /api。
EXPO_PUBLIC_MEETPOINT_API_URL=http://192.168.1.5:4173

# 以下三个变量只供本地 Node 服务或 Vercel Functions 使用。
# 不要添加 EXPO_PUBLIC_ 前缀，也不要提交真实值。
AMAP_WEB_SERVICE_KEY=your_web_service_key
AMAP_JS_KEY=your_js_api_key
AMAP_JS_SECURITY_CODE=your_security_js_code
